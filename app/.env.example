# OpenAI API key — bắt buộc cho embedding (text-embedding-3-small) và generation
OPENAI_API_KEY=sk-your-key-here

# Model dùng cho bước sinh câu trả lời (generation). Mặc định gpt-4o-mini.
# Có thể đổi sang gpt-4o, gpt-4.1-mini, ...
LLM_MODEL=gpt-4o-mini

# (tuỳ chọn) Anthropic key nếu sau này dùng Claude cho generation
ANTHROPIC_API_KEY=
